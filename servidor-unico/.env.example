# =====================================================================
# SiGeRU - configuración de la instalación en un servidor único.
# instalar.sh copia este archivo a .env y completa las contraseñas al azar.
# El .env NO se sube a GitHub.
#
# Las contraseñas deben tener solo letras y números (Apache las lee
# de las variables de entorno al arrancar).
# Si se cambia una contraseña después de la primera instalación, la base
# hay que volver a crearla: docker compose down -v && bash instalar.sh
# =====================================================================
VERSION=1.0.0

# Puertos publicados en el servidor anfitrión (cambiarlos si 80 o 443 están ocupados)
PUERTO_HTTP=80
PUERTO_HTTPS=443

# Nombre e IP con los que se entra al sistema (van en el certificado HTTPS).
# instalar.sh completa SERVIDOR_IP con la IP del anfitrión.
SERVIDOR_NOMBRE=sigeru.local
SERVIDOR_IP=

# Red de Docker de SiGeRU y la IP fija de cada contenedor.
# Las IP fijas permiten que cada usuario de MySQL solo entre desde su contenedor.
# Cambiar la subred solo si choca con la red del lugar (y las cuatro IP con ella).
SUBRED=172.30.50.0/24
IP_WEB=172.30.50.10
IP_API=172.30.50.11
IP_BD=172.30.50.20
IP_RESPALDO=172.30.50.30

# Contraseñas de MySQL: root (solo dentro del contenedor bd) y un usuario por servicio
CLAVE_ROOT_MYSQL=
CLAVE_API_USUARIOS=
CLAVE_API_GESTION=
CLAVE_API_RECOLECCION=
CLAVE_BACKOFFICE=
CLAVE_RESPALDO=

# Valor secreto para anonimizar las IP de los reportes por QR (API de Gestión)
APP_SAL=

# Respaldo automático: hora diaria y días que se conservan
RESPALDO_HORA=02:30
RESPALDO_DIAS=7

# Fecha de referencia de los datos de prueba (03_datos_prueba.sql). Con este valor el
# sistema trabaja como si fuera ese día, así los recorridos, las alertas y los informes
# de los datos de prueba se ven como el día en que se armaron. Vacía = fecha real.
FECHA_SIMULADA=2026-10-30
