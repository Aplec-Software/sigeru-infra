# Configuración del despliegue (copiar a .env). El archivo .env NO se sube a GitHub.
# El script sigeru-admin lo genera con contraseñas al azar (Instalación > Generar .env).
VERSION=1.0.0

# Servidor de base de datos (sigeru-bd)
DB_HOST=192.168.56.20
DB_PORT=3306
DB_NAME=sigeru

# Contraseñas de los usuarios de MySQL de cada servicio (las mismas que se cargan en sigeru-bd)
CLAVE_API_USUARIOS=
CLAVE_API_GESTION=
CLAVE_API_RECOLECCION=
CLAVE_BACKOFFICE=

# Valor secreto para anonimizar las IP de los reportes por QR
APP_SAL=

# Solo para demostraciones y pruebas con los datos de prueba (03_datos_prueba.sql): el sistema funciona como si fuera
# ese día (por ejemplo 2026-10-30, la fecha de referencia de esos datos). En producción se deja vacío.
FECHA_SIMULADA=
